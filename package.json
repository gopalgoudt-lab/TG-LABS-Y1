{
  "name": "tglabs-v6-platform",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && prisma generate && next build",
    "vercel-build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:auth": "node --import tsx --test tests/firebase-auth.test.ts",
    "test:phase2b": "node --import tsx --test tests/phase2b-integrity.test.ts",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:bootstrap": "prisma migrate reset --force --skip-seed",
    "db:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "next": "^15.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@prisma/client": "^6.13.0",
    "zod": "^4.0.0",
    "jose": "^6.0.0",
    "firebase": "^12.2.1",
    "pdf-lib": "^1.17.1"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "prisma": "^6.13.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.0"
  }
}
