generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("NEON_DATABASE_URL")
}

enum BookingMode {
  HOME
  CENTRE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum BookingSource {
  WEBSITE
  ADMIN
}

enum PaymentMode {
  ONLINE
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum PartnerOfferAvailability {
  AVAILABLE
  CHECK_AVAILABILITY
  UNAVAILABLE
}

enum DiagnosticPackageType {
  PACKAGE
  PROFILE
}

model Patient {
  id        String    @id @default(cuid())
  name      String
  phone     String    @unique
  email     String?
  age       Int?
  gender    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
}

model DiagnosticTest {
  id                String                   @id @default(cuid())
  slug              String                   @unique
  catalogCode       String?                  @unique
  name              String
  description       String?
  aliases           String[]                 @default([])
  preparation       String?
  fastingHours      Int?
  parameterCount    Int?
  organTags         String[]                 @default([])
  conditionTags     String[]                 @default([])
  genderRelevance   String[]                 @default([])
  ageRelevance      String[]                 @default([])
  seoTitle          String?
  seoDescription    String?
  mrp               Int                      @default(0)
  price             Int
  imageData         String?
  diagnosticPartner String?
  tat               String?
  fastingNeeded     Boolean                  @default(false)
  sampleTypes       String[]                 @default([])
  sampleTypeOther   String?
  active            Boolean                  @default(true)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  items             BookingItem[]
  packageItems      PackageItem[]
  partnerOffers     TestPartnerOffer[]
  categories        DiagnosticTestCategory[]
}

model DiagnosticPartner {
  id                      String                  @id @default(cuid())
  slug                    String                  @unique
  name                    String                  @unique
  active                  Boolean                 @default(true)
  displayEnabled          Boolean                 @default(false)
  bookingEnabled          Boolean                 @default(false)
  operationalEnabled      Boolean                 @default(false)
  accreditationDisplay    String?
  accreditationReference  String?
  accreditationVerifiedAt DateTime?
  orderHandoffMethod      String?
  reportIntakeMethod      String?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  offers                  TestPartnerOffer[]
  packageOffers           PackagePartnerOffer[]
  serviceability          PartnerServiceability[]

  @@index([active])
  @@index([active, bookingEnabled, operationalEnabled], map: "DiagnosticPartner_operational_idx")
}

model TestPartnerOffer {
  id              String                   @id @default(cuid())
  testId          String
  partnerId       String
  price           Int
  mrp             Int?
  availability    PartnerOfferAvailability @default(CHECK_AVAILABILITY)
  tat             String?
  sourceReference String?
  lastVerifiedAt  DateTime?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  active          Boolean                  @default(true)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  test            DiagnosticTest           @relation(fields: [testId], references: [id], onDelete: Cascade)
  partner         DiagnosticPartner        @relation(fields: [partnerId], references: [id])
  bookingItems    BookingItem[]

  @@unique([testId, partnerId])
  @@index([partnerId, availability, active])
  @@index([testId, availability, active])
  @@index([active, lastVerifiedAt, effectiveFrom, effectiveTo], map: "TestPartnerOffer_eligibility_idx")
}

model DiagnosticPackage {
  id                String                      @id @default(cuid())
  slug              String                      @unique
  catalogCode       String?                     @unique
  packageType       DiagnosticPackageType       @default(PACKAGE)
  name              String
  description       String?
  aliases           String[]                    @default([])
  preparation       String?
  fastingHours      Int?
  parameterCount    Int?
  seoTitle          String?
  seoDescription    String?
  mrp               Int                         @default(0)
  price             Int
  imageData         String?
  diagnosticPartner String?
  tat               String?
  fastingNeeded     Boolean                     @default(false)
  sampleTypes       String[]                    @default([])
  sampleTypeOther   String?
  active            Boolean                     @default(true)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  tests             PackageItem[]
  bookings          BookingPackage[]
  categories        DiagnosticPackageCategory[]
  partnerOffers     PackagePartnerOffer[]
}

model CatalogCategory {
  id             String                      @id @default(cuid())
  slug           String                      @unique
  name           String
  description    String?
  active         Boolean                     @default(false)
  sortOrder      Int                         @default(0)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  tests          DiagnosticTestCategory[]
  packages       DiagnosticPackageCategory[]

  @@index([active, sortOrder])
}

model DiagnosticTestCategory {
  testId     String
  categoryId String
  test       DiagnosticTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  category   CatalogCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([testId, categoryId])
  @@index([categoryId])
}

model DiagnosticPackageCategory {
  packageId  String
  categoryId String
  package    DiagnosticPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category   CatalogCategory   @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([packageId, categoryId])
  @@index([categoryId])
}

model PackagePartnerOffer {
  id              String                   @id @default(cuid())
  packageId       String
  partnerId       String
  price           Int
  mrp             Int?
  availability    PartnerOfferAvailability @default(CHECK_AVAILABILITY)
  tat             String?
  sourceReference String?
  lastVerifiedAt  DateTime?
  effectiveFrom   DateTime?
  effectiveTo     DateTime?
  active          Boolean                  @default(false)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  package         DiagnosticPackage        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  partner         DiagnosticPartner        @relation(fields: [partnerId], references: [id], onDelete: Restrict)
  bookingPackages BookingPackage[]

  @@unique([packageId, partnerId])
  @@index([partnerId, availability, active])
  @@index([packageId, availability, active])
  @@index([active, lastVerifiedAt, effectiveFrom, effectiveTo], map: "PackagePartnerOffer_eligibility_idx")
}

model PartnerServiceability {
  id                    String            @id @default(cuid())
  partnerId             String
  pincode               String
  homeCollectionEnabled Boolean           @default(false)
  active                Boolean           @default(false)
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  partner               DiagnosticPartner @relation(fields: [partnerId], references: [id], onDelete: Restrict)

  @@unique([partnerId, pincode])
  @@index([pincode, active, homeCollectionEnabled], map: "PartnerServiceability_lookup_idx")
}

model PackageItem {
  id        String            @id @default(cuid())
  packageId String
  testId    String
  package   DiagnosticPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  test      DiagnosticTest    @relation(fields: [testId], references: [id])

  @@unique([packageId, testId])
  @@index([testId])
}

model Technician {
  id           String              @id @default(cuid())
  name         String
  phone        String              @unique
  email        String?
  employeeCode String?             @unique
  pincodes     String[]            @default([])
  active       Boolean             @default(true)
  notes        String?
  loginPinHash String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  bookings     Booking[]
  sessions     TechnicianSession[]

  @@index([active])
}

model TechnicianSession {
  id           String     @id @default(cuid())
  technicianId String
  tokenHash    String     @unique
  expiresAt    DateTime
  createdAt    DateTime   @default(now())
  technician   Technician @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@index([technicianId])
  @@index([expiresAt])
}

model Booking {
  id                   String               @id @default(cuid())
  idempotencyKey       String?              @unique
  patientId            String
  patient              Patient              @relation(fields: [patientId], references: [id])
  mode                 BookingMode
  source               BookingSource        @default(WEBSITE)
  address              String?
  pincode              String?
  doctorName           String?
  printedReport        Boolean              @default(false)
  printedReportFee     Int                  @default(0)
  collectionDate       DateTime
  slot                 String
  status               BookingStatus        @default(PENDING)
  paymentStatus        PaymentStatus        @default(PENDING)
  paymentMode          PaymentMode?
  totalAmount          Int
  technician           String?
  technicianId         String?
  assignedTechnician   Technician?          @relation(fields: [technicianId], references: [id])
  workflowStatus       String               @default("BOOKING_CREATED")
  bookingConfirmedAt   DateTime?
  technicianAssignedAt DateTime?
  technicianAcceptedAt DateTime?
  technicianOnTheWayAt DateTime?
  technicianReachedAt  DateTime?
  sampleCollectedAt    DateTime?
  sampleReceivedAt     DateTime?
  processingStartedAt  DateTime?
  reportReadyAt        DateTime?
  reportDeliveredAt    DateTime?
  technicianNotes      String?
  reportName           String?
  reportData           String?
  aiReportEn           String?
  aiReportTe           String?
  aiReportHi           String?
  aiReportEnAt         DateTime?
  aiReportTeAt         DateTime?
  aiReportHiAt         DateTime?
  adminNotes           String?
  createdByAdmin       String?
  razorpayOrderId      String?              @unique
  razorpayPaymentId    String?              @unique
  paidAt               DateTime?
  whatsappNotifiedAt   DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  items                BookingItem[]
  packages             BookingPackage[]
  payments             PaymentTransaction[]

  @@index([patientId])
  @@index([technicianId])
  @@index([collectionDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([source])
  @@index([workflowStatus])
}

model PaymentTransaction {
  id                 String        @id @default(cuid())
  bookingId          String
  booking            Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  provider           String        @default("RAZORPAY")
  orderId            String
  paymentId          String?       @unique
  status             PaymentStatus @default(PENDING)
  amount             Int
  currency           String        @default("INR")
  signatureVerified  Boolean       @default(false)
  source             String
  failureCode        String?
  failureDescription String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([bookingId])
  @@index([orderId])
  @@index([status])
}

model RazorpayWebhookEvent {
  eventId         String    @id
  eventType       String
  paymentId       String?
  orderId         String?
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  processingError String?

  @@index([eventType])
  @@index([paymentId])
  @@index([orderId])
}

model BookingItem {
  id                  String                    @id @default(cuid())
  bookingId           String
  testId              String
  offerId             String?
  partnerId           String?
  partnerName         String?
  partnerTat          String?
  partnerAvailability PartnerOfferAvailability?
  price               Int
  booking             Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  test                DiagnosticTest            @relation(fields: [testId], references: [id])
  offer               TestPartnerOffer?         @relation(fields: [offerId], references: [id])

  @@unique([bookingId, testId])
  @@index([offerId])
  @@index([partnerId])
}

model BookingPackage {
  id                  String                    @id @default(cuid())
  bookingId           String
  packageId           String
  offerId             String?
  partnerId           String?
  partnerName         String?
  partnerTat          String?
  partnerAvailability PartnerOfferAvailability?
  price               Int
  booking             Booking                   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  package             DiagnosticPackage         @relation(fields: [packageId], references: [id])
  offer               PackagePartnerOffer?      @relation(fields: [offerId], references: [id], onDelete: SetNull)

  @@unique([bookingId, packageId])
  @@index([packageId])
  @@index([offerId])
  @@index([partnerId])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  adminPhone String
  action     String
  entityType String
  entityId   String?
  summary    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([adminPhone])
  @@index([action])
  @@index([entityType])
  @@index([entityId])
  @@index([createdAt])
}

model ThyrocareCredential {
  id           String   @id @default(cuid())
  phone        String
  role         String
  passwordHash String
  passwordSalt String
  iterations   Int      @default(210000)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([phone, role])
  @@index([phone])
  @@index([role])
}
